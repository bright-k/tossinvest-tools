#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
BEFORE=$(shasum -a 256 internal/broker/toss/generated/client.gen.go internal/broker/toss/dispatch.gen.go)
./scripts/generate
AFTER=$(shasum -a 256 internal/broker/toss/generated/client.gen.go internal/broker/toss/dispatch.gen.go)
if [ "$BEFORE" != "$AFTER" ]; then echo 'Generated files changed. Review generator inputs and commit regenerated results.' >&2; exit 1; fi
printf '%s\n' 'Generated files are reproducible.'
